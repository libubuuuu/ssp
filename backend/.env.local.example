# ============================================================
# 本地开发环境配置（Windows）
# 使用方法：把这个文件复制为 .env（去掉 .example 后缀）
#           然后把下面的占位符替换为真实值
# 注意：.env 文件不会被上传到 GitHub（已加入 .gitignore）
# ============================================================

# 数据库：本地独立测试库，和线上完全隔离
DATABASE_PATH=./dev-test.db

# 认证密钥：本地随便填，线上另有真实值
JWT_SECRET=local-dev-only-not-for-production-abc123

# FAL AI Key：复制线上服务器的值
# 获取方式：问管理员拿，或在 /etc/ssp/master.key 解密后找到
FAL_KEY=请填入真实FAL_KEY

# 前端地址（本地开发固定这两行，不用改）
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
COOKIE_SECURE=False
ENVIRONMENT=development

# 以下为可选配置，本地开发不填也能启动
# 不填则对应功能不可用，不影响核心功能测试
IMAGE_API_KEY=
LINGMENG_API_KEY=
DEEPSEEK_API_KEY=
GEMINI_API_KEY=
RESEND_API_KEY=
HUPIJIAO_SECRET=
