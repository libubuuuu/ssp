# 企业微信配置 — 复制为 /etc/ssp/wechat-bot.env 并填写真实值
# 获取方式见下方注释

# 企业ID — 企业微信后台 → 我的企业 → 企业信息 → 企业ID
WECHAT_CORP_ID=ww开头的企业ID

# 自建应用ID — 企业微信后台 → 应用管理 → 你创建的应用 → AgentId
WECHAT_AGENT_ID=123456

# 应用Secret — 企业微信后台 → 应用管理 → 你创建的应用 → Secret（点击查看）
WECHAT_CORP_SECRET=你的应用Secret

# 接收消息Token — 企业微信后台 → 应用 → 接收消息 → 随机生成或自定义
WECHAT_TOKEN=你设置的Token

# 消息加密密钥 — 企业微信后台 → 应用 → 接收消息 → EncodingAESKey（43位）
WECHAT_ENCODING_AES_KEY=你的43位AESKey

# 管理员企业微信UserID — 企业微信后台 → 通讯录 → 你自己 → 账号(UserID)
WECHAT_ADMIN_USER_ID=你的UserID
